    {"path": "axis0.controller.config.anticogging.calib_vel_threshold", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Anticogging", "tab": "controller", "description": "No description in the firmware interface."},
    {"path": "axis0.controller.config.anticogging.index", "protocol": "odrive", "type": "integer", "access": "read", "unit": "", "group": "Anticogging", "tab": "controller", "description": "No description in the firmware interface."},
    {"path": "axis.maxtorque", "protocol": "offb", "type": "float", "access": "write", "unit": "Nm", "min": 0, "group": "Force scale", "tab": "ffb-wheel", "description": "Maximum torque the FFB layer may request."},
    {"path": "fx.master", "protocol": "offb", "type": "integer", "access": "write", "unit": "", "min": 0, "max": 255, "group": "Effect gains", "tab": "ffb-effects", "description": "Master gain of the game effects."}
