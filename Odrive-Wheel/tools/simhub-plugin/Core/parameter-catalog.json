    {"path": "axis0.motor.config.requested_current_range", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Type / calibration", "tab": "motor", "description": "Current ADC range. Must be ≥ current_lim + current_lim_margin."},
    {"path": "axis0.motor.config.current_control_bandwidth", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s", "group": "Type / calibration", "tab": "motor", "description": "Current PI loop bandwidth in rad/s. 100-1000. Higher = faster response and more noise."},
    {"path": "axis0.motor.config.current_control_deadband", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Type / calibration", "tab": "motor", "description": "Dead-band on the current PI error in A (Odrive-Wheel mod). Below this value the PI ignores the error: P = 0 and integrator freezes. Kills idle vibration caused by the PI chasing ADC/encoder noise. Does not affect dynamic response (outside the band the loop is identical to stock). Static uncertainty introduced ≈ value × torque_constant (a few mNm — imperceptible). 0 = disabled. Default 0.1 (100 mA). Useful range 0.02–0.20."},
    {"path": "axis0.motor.config.dc_calib_tau", "protocol": "odrive", "type": "float", "access": "write", "unit": "s", "group": "Type / calibration", "tab": "motor", "description": "DC calibration time constant (s)."},
    {"path": "axis0.motor.config.current_lim", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "min": 0, "group": "Limits", "tab": "motor", "description": "Motor current limit, the hard cap on torque."},
    {"path": "axis0.motor.config.current_lim_margin", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Limits", "tab": "motor", "description": "Margin between current_lim and hw trip (A). Tolerates transients."},
    {"path": "axis0.motor.config.torque_lim", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m", "group": "Limits", "tab": "motor", "description": "Hard torque limit (Nm). Inf = only limited by current_lim."},
    {"path": "axis0.motor.config.I_bus_hard_min", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Limits", "tab": "motor", "description": "Hard limit on motor negative DC current (A). Limits regen."},
    {"path": "axis0.motor.config.I_bus_hard_max", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Limits", "tab": "motor", "description": "Hard limit on motor positive DC current (A). Limits consumption."},
    {"path": "axis0.motor.config.I_leak_max", "protocol": "odrive", "type": "float", "access": "write", "unit": "A", "group": "Limits", "tab": "motor", "description": "Max allowed leak current."},
    {"path": "axis0.motor.fet_thermistor.config.enabled", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "FET thermistor (onboard)", "tab": "motor", "description": "Enables monitoring of gate driver / MOSFET temperature (onboard sensor). When T crosses temp_limit_lower, current_lim is progressively reduced down to 0 at temp_limit_upper. Default: True (recommended)."},
    {"path": "axis0.motor.fet_thermistor.config.temp_limit_lower", "protocol": "odrive", "type": "float", "access": "write", "unit": "°C", "group": "FET thermistor (onboard)", "tab": "motor", "description": "Temperature (°C) where current_lim begins to be reduced linearly. Default 100°C."},
    {"path": "axis0.motor.fet_thermistor.config.temp_limit_upper", "protocol": "odrive", "type": "float", "access": "write", "unit": "°C", "group": "FET thermistor (onboard)", "tab": "motor", "description": "Temperature (°C) where current_lim reaches 0 and triggers FET_THERMISTOR_OVER_TEMP (0x4000). Default 120°C."},
    {"path": "axis0.motor.motor_thermistor.config.enabled", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "Enables motor temperature monitoring via an external NTC. Requires NTC + pull-up on the GPIO configured as ANALOG_IN. Use the \"Calculate coefficients\" button to generate the polynomial from your NTC spec."},
    {"path": "axis0.motor.motor_thermistor.config.gpio_pin", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "GPIO where the NTC is connected. The pin is set to ANALOG_IN — STM32 does NOT allow an internal pull-up in analog mode (F405 datasheet). YOU MUST INSTALL AN EXTERNAL 10kΩ PULL-UP between 3.3V and the GPIO; the NTC goes between the GPIO and GND. Without the pull-up, the ADC always reads 0V → polynomial returns the c0 term (looks like \"stuck temperature\"). Conflicts with joystick inputs — dedicate 1 GPIO. Default 4."},
    {"path": "axis0.motor.motor_thermistor.config.temp_limit_lower", "protocol": "odrive", "type": "float", "access": "write", "unit": "°C", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "Temperature (°C) where current_lim begins to be reduced linearly. Default 100°C (typical for BLDC)."},
    {"path": "axis0.motor.motor_thermistor.config.temp_limit_upper", "protocol": "odrive", "type": "float", "access": "write", "unit": "°C", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "Temperature (°C) where current_lim reaches 0 and triggers MOTOR_THERMISTOR_OVER_TEMP (0x8000). Default 120°C."},
    {"path": "axis0.motor.motor_thermistor.config.poly_coefficient_0", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "c0 of polynomial T(°C) = c0 + c1·V + c2·V² + c3·V³ where V is the normalized [0,1] ADC voltage. Use \"Calculate coefficients\" to generate automatically."},
    {"path": "axis0.motor.motor_thermistor.config.poly_coefficient_1", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "c1 of polynomial (see poly_coefficient_0)."},
    {"path": "axis0.motor.motor_thermistor.config.poly_coefficient_2", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "c2 of polynomial (see poly_coefficient_0)."},
    {"path": "axis0.motor.motor_thermistor.config.poly_coefficient_3", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Motor thermistor (offboard NTC)", "tab": "motor", "description": "c3 of polynomial (see poly_coefficient_0)."},
    {"path": "axis0.motor.config.R_wL_FF_enable", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Feed-forward", "tab": "motor", "description": "Enables automatic feedforward of the R*wL term in the current controller."},
    {"path": "axis0.motor.config.bEMF_FF_enable", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Feed-forward", "tab": "motor", "description": "Enables automatic feedforward of the bEMF term in the current controller."},
    {"path": "axis0.motor.config.acim_gain_min_flux", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "ACIM (induction only)", "tab": "motor", "description": "No description in the firmware interface."},
    {"path": "axis0.motor.config.acim_autoflux_enable", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "ACIM (induction only)", "tab": "motor", "description": "No description in the firmware interface."},
    {"path": "axis0.motor.config.acim_autoflux_min_Id", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "ACIM (induction only)", "tab": "motor", "description": "No description in the firmware interface."},
    {"path": "axis0.motor.config.acim_autoflux_attack_gain", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "ACIM (induction only)", "tab": "motor", "description": "No description in the firmware interface."},
    {"path": "axis0.motor.config.acim_autoflux_decay_gain", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "ACIM (induction only)", "tab": "motor", "description": "No description in the firmware interface."},
    {"path": "axis0.encoder.config.mode", "protocol": "odrive", "type": "enum", "enum": "encoderMode", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "description": "Encoder type: incremental, hall, SPI absolute, sin/cos, etc."},
    {"path": "axis0.encoder.config.cpr", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "description": "Counts per revolution (4× pulses for quadrature encoder)."},
    {"path": "axis0.encoder.config.direction", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "calibrated": true, "description": "Encoder direction (1 or -1). Calibrated automatically by motor_calibration (firmware applies known torque and measures which way the encoder responds). Manually editing flips the sign in the Park transform → FOC sees inverted sign → motor oscillates / spins wrong / disarms. To flip the wheel direction from the user/game perspective, use axis.invert in the FFB Wheel tab."},
    {"path": "axis0.encoder.config.bandwidth", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s", "group": "Mode / resolution", "tab": "encoder", "description": "PLL estimator bandwidth in rad/s (Hz equivalent shown alongside). Typical ABZ encoder: 100-500; MT6835/AS5047 handle 1000-2000. Sets the noise vs. lag trade-off of the velocity used by damper/friction/inertia."},
    {"path": "axis0.encoder.config.pre_calibrated", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "description": "True = skips offset cal at boot. Use after calibrating and saving."},
    {"path": "axis0.encoder.config.phase_offset", "protocol": "odrive", "type": "integer", "access": "write", "unit": "counts", "group": "Mode / resolution", "tab": "encoder", "calibrated": true, "description": "Offset between encoder zero and motor phase A (counts). Calibrated by encoder_offset_calibration. Manually editing breaks the Park transform → motor may oscillate or spin the wrong way. To invert the user-facing direction use axis.invert in the FFB Wheel tab."},
    {"path": "axis0.encoder.config.phase_offset_float", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "calibrated": true, "description": "Fraction of a count on top of phase_offset, measured by the encoder offset calibration."},
    {"path": "axis0.encoder.config.enable_phase_interpolation", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Mode / resolution", "tab": "encoder", "description": "Phase interpolation between counts. Reduces cogging."},
    {"path": "axis0.encoder.config.use_index", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Index / offset", "tab": "encoder", "description": "Uses encoder Z index pulse to zero."},
    {"path": "axis0.encoder.config.use_index_offset", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Index / offset", "tab": "encoder", "description": "Applies offset relative to index."},
    {"path": "axis0.encoder.config.index_offset", "protocol": "odrive", "type": "float", "access": "write", "unit": "turn", "group": "Index / offset", "tab": "encoder", "description": "Offset in turns applied when the Z pulse is detected. Defines where the \"mechanical zero\" sits relative to the Z pulse. Ex: 0=mechanical center on Z; +0.25=mechanical center 90° after Z. Use the slider below to fine-tune in degrees (0.5° resolution, ±180° = ±0.5 turns range — any value beyond that is equivalent to a smaller angle in the opposite direction)."},
    {"path": "axis0.encoder.config.find_idx_on_lockin_only", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Index / offset", "tab": "encoder", "description": "Searches index only during lockin (more robust)."},
    {"path": "axis0.encoder.config.calib_range", "protocol": "odrive", "type": "float", "access": "write", "unit": "turn", "group": "Calibration", "tab": "encoder", "description": "Error tolerance during cal (turns)."},
    {"path": "axis0.encoder.config.calib_scan_distance", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad (electrical)", "group": "Calibration", "tab": "encoder", "description": "Angular scan distance during cal (rad)."},
    {"path": "axis0.encoder.config.calib_scan_omega", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s (electrical)", "group": "Calibration", "tab": "encoder", "description": "Scan velocity (rad/s)."},
    {"path": "axis0.encoder.config.hall_polarity", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Hall", "tab": "encoder", "description": "No description in the firmware interface."},
    {"path": "axis0.encoder.config.hall_polarity_calibrated", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Hall", "tab": "encoder", "description": "No description in the firmware interface."},
    {"path": "axis0.encoder.config.ignore_illegal_hall_state", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Hall", "tab": "encoder", "description": "Ignore the error \"Illegal Hall State\""},
    {"path": "axis0.encoder.config.abs_spi_cs_gpio_pin", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Pins", "tab": "encoder", "description": "Make sure that the GPIO is in `GPIO_MODE_DIGITAL`."},
    {"path": "axis0.encoder.config.sincos_gpio_pin_sin", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Pins", "tab": "encoder", "description": "Analog sine signal of a sin/cos encoder."},
    {"path": "axis0.encoder.config.sincos_gpio_pin_cos", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Pins", "tab": "encoder", "description": "Analog cosine signal of a sin/cos encoder."},
    {"path": "axis0.controller.config.control_mode", "protocol": "odrive", "type": "enum", "enum": "controlMode", "access": "write", "unit": "", "group": "Control mode", "tab": "controller", "description": "TORQUE / VELOCITY / POSITION. For FFB use TORQUE."},
    {"path": "axis0.controller.config.input_mode", "protocol": "odrive", "type": "enum", "enum": "inputMode", "access": "write", "unit": "", "group": "Control mode", "tab": "controller", "description": "PASSTHROUGH (direct), VEL_RAMP, POS_FILTER, TRAP_TRAJ. For FFB use PASSTHROUGH."},
    {"path": "axis0.controller.config.input_filter_bandwidth", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s", "group": "Control mode", "tab": "controller", "description": "Input filter bandwidth in rad/s (Hz equivalent shown alongside). Only active in POS_FILTER mode."},
    {"path": "axis0.controller.config.torque_ramp_rate", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m / sec", "group": "Control mode", "tab": "controller", "description": "Torque slew rate in Nm/s. Only active in TORQUE_RAMP input mode."},
    {"path": "axis0.controller.config.vel_ramp_rate", "protocol": "odrive", "type": "float", "access": "write", "unit": "turn/s^2", "group": "Control mode", "tab": "controller", "description": "Velocity slew rate."},
    {"path": "axis0.controller.config.pos_gain", "protocol": "odrive", "type": "float", "access": "write", "unit": "(turn/s) / turn", "group": "PID gains", "tab": "controller", "description": "Position proportional gain."},
    {"path": "axis0.controller.config.vel_gain", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m / (turn/s)", "group": "PID gains", "tab": "controller", "description": "Velocity proportional gain."},
    {"path": "axis0.controller.config.vel_integrator_gain", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m / (turn/s * s)", "group": "PID gains", "tab": "controller", "description": "Velocity integral gain."},
    {"path": "axis0.controller.config.vel_integrator_limit", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m", "group": "PID gains", "tab": "controller", "description": "Integrator anti-windup limit."},
    {"path": "axis0.controller.config.inertia", "protocol": "odrive", "type": "float", "access": "write", "unit": "N·m/(turn/s^2)", "group": "PID gains", "tab": "controller", "description": "Estimated load mass (kg·m²). For feed-forward."},
    {"path": "axis0.controller.config.enable_gain_scheduling", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "PID gains", "tab": "controller", "description": "Reduces gains at low velocity."},
    {"path": "axis0.controller.config.gain_scheduling_width", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "PID gains", "tab": "controller", "description": "Gain scheduling width."},
    {"path": "axis0.controller.config.enable_vel_limit", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Velocity limits", "tab": "controller", "description": "Limits velocity. Also in torque mode (if enable_torque_mode_vel_limit)."},
    {"path": "axis0.controller.config.enable_torque_mode_vel_limit", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Velocity limits", "tab": "controller", "description": "Applies vel_limit in torque mode. For FFB recommend False."},
    {"path": "axis0.controller.config.vel_limit", "protocol": "odrive", "type": "float", "access": "write", "unit": "turn/s", "group": "Velocity limits", "tab": "controller", "description": "Max velocity in turns/s. For wheel use 10+ to handle aggressive maneuvers."},
    {"path": "axis0.controller.config.vel_limit_tolerance", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Velocity limits", "tab": "controller", "description": "Multiplier before overspeed error fires (1.2 = 20% margin)."},
    {"path": "axis0.controller.config.enable_overspeed_error", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Velocity limits", "tab": "controller", "description": "Fires error if vel exceeds limit × tolerance."},
    {"path": "axis0.controller.config.circular_setpoints", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Circular position", "tab": "controller", "description": "No description in the firmware interface."},
    {"path": "axis0.controller.config.circular_setpoint_range", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Circular position", "tab": "controller", "description": "circular range in [turns] for position setpoints when circular_setpoints is True"},
    {"path": "axis0.controller.config.steps_per_circular_range", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Circular position", "tab": "controller", "description": "Number of steps within the circular setpoint range."},
    {"path": "axis0.controller.config.homing_speed", "protocol": "odrive", "type": "float", "access": "write", "unit": "turn/s", "group": "Homing / mirror", "tab": "controller", "description": "The speed at which the axis moves towards the `min_endstop` during `AXIS_STATE_HOMING`"},
    {"path": "axis0.controller.config.load_encoder_axis", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Homing / mirror", "tab": "controller", "description": "Default depends on Axis number and is set in load_configuration()"},
    {"path": "axis0.controller.config.axis_to_mirror", "protocol": "odrive", "type": "integer", "access": "write", "unit": "", "group": "Homing / mirror", "tab": "controller", "description": "The axis used for mirroring when in `INPUT_MODE_MIRROR`"},
    {"path": "axis0.controller.config.mirror_ratio", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Homing / mirror", "tab": "controller", "description": "The ratio applied to position and velocity movements of the mirrored axis."},
    {"path": "axis0.controller.config.torque_mirror_ratio", "protocol": "odrive", "type": "float", "access": "write", "unit": "", "group": "Homing / mirror", "tab": "controller", "description": "The ratio applied to torque values of the mirrored axis."},
    {"path": "axis0.controller.config.electrical_power_bandwidth", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s", "group": "Power monitoring", "tab": "controller", "description": "Electrical power estimator filter in rad/s (Hz equivalent shown alongside). Lower = ignores spikes."},
    {"path": "axis0.controller.config.mechanical_power_bandwidth", "protocol": "odrive", "type": "float", "access": "write", "unit": "rad/s", "group": "Power monitoring", "tab": "controller", "description": "Mechanical power estimator filter in rad/s (Hz equivalent shown alongside)."},
    {"path": "axis0.controller.config.spinout_electrical_power_threshold", "protocol": "odrive", "type": "float", "access": "write", "unit": "Watt", "group": "Power monitoring", "tab": "controller", "description": "Spinout electrical power threshold (W). Raise to 50 if intense FFB triggers it."},
    {"path": "axis0.controller.config.spinout_mechanical_power_threshold", "protocol": "odrive", "type": "float", "access": "write", "unit": "Watt", "group": "Power monitoring", "tab": "controller", "description": "Spinout negative mechanical power threshold (W). -50 is safe."},
