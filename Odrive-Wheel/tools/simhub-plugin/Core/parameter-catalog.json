    {"path": "config.dc_bus_overvoltage_ramp_end", "protocol": "odrive", "type": "float", "access": "write", "unit": "V", "group": "Power / Brake", "tab": "odrv", "editable": true, "description": "Voltage where brake saturates at 100%. Ex: 27V (must be < trip)."},
