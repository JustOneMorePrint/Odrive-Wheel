    {"path": "config.brake_resistance", "protocol": "odrive", "type": "float", "access": "write", "unit": "ohm", "group": "Power / Brake", "tab": "odrv", "editable": true, "description": "Brake resistor value in ohms. Must match physical resistor — wrong value causes incorrect PWM duty. You can check the power dissipated in the resistor during braking by enabling P brake in Tools-Overlay."},
    {"path": "config.enable_brake_resistor", "protocol": "odrive", "type": "boolean", "access": "write", "unit": "", "group": "Power / Brake", "tab": "odrv", "editable": true, "description": "Enables brake circuit. Without this, regen flows to PSU and can trigger OVP."},
    {"path": "config.dc_bus_undervoltage_trip_level", "protocol": "odrive", "type": "float", "access": "write", "unit": "V", "group": "Power / Brake", "tab": "odrv", "editable": true, "description": "Minimum DC bus voltage. Below this ODrive disarms with UNDER_VOLTAGE error."},
    {"path": "config.dc_bus_overvoltage_trip_level", "protocol": "odrive", "type": "float", "access": "write", "unit": "V", "group": "Power / Brake", "tab": "odrv", "editable": true, "description": "Maximum DC bus voltage. Above this ODrive disarms. Set between PSU+5V and cap rating."},
