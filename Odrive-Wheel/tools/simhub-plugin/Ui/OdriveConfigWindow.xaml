<Window x:Class="OdriveWheel.SimHubPlugin.OdriveConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odrive-Wheel configuration"
        Width="900" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="#EEEEEE"
        FontFamily="Segoe UI"
        FontSize="13">

    <!-- All styles live here: this window runs on its own UI thread and must not
         depend on SimHub's resources. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BgCard"     Color="#242628"/>
        <SolidColorBrush x:Key="BgCardAlt"  Color="#2A2C30"/>
        <SolidColorBrush x:Key="BorderCard" Color="#3A3D42"/>
        <SolidColorBrush x:Key="Fg"         Color="#EEEEEE"/>
        <SolidColorBrush x:Key="FgMuted"    Color="#9AA0A6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#3FB8A9"/>
        <SolidColorBrush x:Key="DangerDeep" Color="#C0392B"/>
        <SolidColorBrush x:Key="DangerDark" Color="#8E2A20"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource FgMuted}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentSoft}"/>
            <Setter Property="Margin"     Value="0,12,0,6"/>
        </Style>
        <Style x:Key="LiveValue" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="Foreground"   Value="{StaticResource Fg}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"  Value="{StaticResource BgCardAlt}"/>
            <Setter Property="Foreground"  Value="{StaticResource Fg}"/>
            <Setter Property="CaretBrush"  Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
            <Setter Property="Padding"     Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgCardAlt}"/>
            <Setter Property="Foreground"      Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keeps its strong colour in every state, the system template would fade it. -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerDeep}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="16"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="14,7" Cursor="Hand">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outside the tabs and any scrolling, so the stop button is always visible. -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionLed" Width="12" Height="12" Fill="#555555"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionText" Text="…" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="AxisStateText" Style="{StaticResource Muted}" Margin="20,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PortButton" Content="Release port"
                                Style="{StaticResource SecondaryButton}" Click="OnTogglePort"/>
                        <Button x:Name="ClearStopButton" Content="Clear stop" Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}" Click="OnClearStop"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="StopButton" Grid.Row="0" Grid.Column="1"
                        Content="SOFTWARE STOP (IDLE)"
                        Width="250" MinHeight="64"
                        Style="{StaticResource StopButtonStyle}"
                        Click="OnStop"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <TextBlock x:Name="StopStatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StopDisclaimerText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The read-only ODrive tabs are added from the catalog, before Extensions. -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StatusStack" Margin="16,4,16,16"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Extensions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ExtensionsStack" Margin="16,12,16,16"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
